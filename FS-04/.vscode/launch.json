{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django API (runserver)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "django": true
    },
    {
      "name": "Celery worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "config", "worker", "-l", "info", "--pool=solo"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
