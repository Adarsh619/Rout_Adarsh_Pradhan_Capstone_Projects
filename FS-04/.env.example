# Copy to .env  (never commit .env)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Local (non-Docker) development. Docker Compose overrides these two.
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0

# Set to true to run Celery tasks inline (no worker needed) — handy for quick local dev
CELERY_TASK_ALWAYS_EAGER=false

# --- Stripe billing ---------------------------------------------------------
# Mock mode (default): Stripe's official stripe-mock server + a simulated checkout page.
# No Stripe account, card or keys needed. Stripe is invite-only in India, so this is the default.
STRIPE_MOCK=true
# Only used in mock mode when running WITHOUT Docker (Docker Compose sets it to http://stripe-mock:12111)
STRIPE_API_BASE=http://localhost:12111

# Real Stripe TEST MODE (optional): set STRIPE_MOCK=false and fill these from dashboard.stripe.com (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email: console backend prints emails to the worker logs
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Outgoing webhooks refuse internal/private addresses. Set true ONLY to test a receiver on your own machine.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# --- Docker -------------------------------------------------------------------
# Host port for the app (change it if 3000 is taken, e.g. by a dev server).
FRONTEND_PORT=3000
# Gunicorn web worker processes in the backend container.
WEB_CONCURRENCY=3

# --- Frontend ----------------------------------------------------------------
# Show "Demo: owner@acme.test / demo12345" on the sign-in page. Set to false for a public deployment.
VITE_DEMO_HINT=true
