# Copy to .env  (never commit .env)
# Signs login tokens. Use a long random string anywhere other than your own machine.
SECRET_KEY=change-me-to-a-long-random-string
# true: development mode (the demo seed may run without --force). Set false on a server.
DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Local (non-Docker) development. Docker Compose overrides these two.
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0

# true: run background jobs inside the API process (no worker or Redis needed); handy for quick local dev.
JOBS_INLINE=false

# --- Stripe billing ---------------------------------------------------------
# Mock mode (default): Stripe's official stripe-mock server + a simulated checkout page.
# No Stripe account, card or keys needed. Stripe is invite-only in India, so this is the default.
STRIPE_MOCK=true
# Only used in mock mode when running WITHOUT Docker (Docker Compose sets it to http://stripe-mock:12111)
STRIPE_API_BASE=http://localhost:12111

# Real Stripe TEST MODE (optional): set STRIPE_MOCK=false and fill these from dashboard.stripe.com (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email: "console" prints emails to the worker log; an smtp:// URL sends them for real.
EMAIL_TRANSPORT=console

# Outgoing webhooks refuse internal/private addresses. Set true ONLY to test a receiver on your own machine.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# --- Docker -------------------------------------------------------------------
# Host port for the app (change it if 3000 is taken, e.g. by a dev server).
FRONTEND_PORT=3000
# Only for docker-compose.release.yml: which published version to run (latest, 2.0.0, sha-<commit>).
TASKFLOW_TAG=latest

# --- Frontend ----------------------------------------------------------------
# Show "Demo: owner@acme.test / demo12345" on the sign-in page. Set to false for a public deployment.
VITE_DEMO_HINT=true
