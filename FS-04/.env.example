# Copy to .env  (never commit .env)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Local (non-Docker) development. Docker Compose overrides these two.
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379/0

# Set to true to run Celery tasks inline (no worker needed) — handy for quick local dev
CELERY_TASK_ALWAYS_EAGER=false

# Stripe TEST MODE keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email: console backend prints emails to the worker logs
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
