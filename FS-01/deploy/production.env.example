# Live server settings. On the server: cp deploy/production.env.example .env && nano .env
# Fill in the four secrets below ON THE SERVER ONLY. Never paste them into chat, Git or a screenshot.

DOMAIN=shopsphere-adarsh.duckdns.org
S3_BUCKET=shopsphere-media-2026
LOG_LEVEL=info

# 1. MongoDB Atlas: Database -> Connect -> Drivers. Put the database name "shopsphere" before the "?", e.g.
#    mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shopsphere?retryWrites=true&w=majority
MONGO_URL=

# 2. Signs sign-in tokens. Generate a new one on the server:
#    openssl rand -base64 48 | tr -d '\n=+/' ; echo
JWT_ACCESS_SECRET=

# 3. Razorpay TEST keys (Dashboard -> Test Mode -> API Keys). Live keys are refused by the app.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after creating the webhook in the Razorpay dashboard (any long random text you choose; same value in both places)
RAZORPAY_WEBHOOK_SECRET=

# 4. Password for the demo accounts (customer, vendors, admin) created by the seed scripts
DEMO_PASSWORD=

# No S3 keys: the server's role (shopsphere-ec2-role) gives the API access to the bucket.
