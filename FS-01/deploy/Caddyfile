# Caddy gets and renews the Let's Encrypt certificate for {$DOMAIN} by itself (ports 80 and 443 must be open)
# and redirects http to https.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API straight to Node (one proxy hop, so the API's `trust proxy 1` sees the visitor's real address).
	handle /api/* {
		reverse_proxy api:4000
	}

	# Everything else: the web app.
	handle {
		reverse_proxy web:80
	}
}
