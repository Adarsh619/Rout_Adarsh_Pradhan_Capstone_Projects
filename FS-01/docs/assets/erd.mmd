  USERS { uuid id PK text email UK Role role AccountStatus status }
  ADDRESSES { uuid id PK uuid userId FK bool isDefault }
  VENDORS { uuid id PK uuid userId FK,UK text slug UK VendorStatus status int commissionRateBp PayoutAccountStatus payoutStatus }
  CATEGORIES { uuid id PK text slug UK uuid parentId FK int commissionRateBp bool isActive }
  PRODUCTS { uuid id PK uuid vendorId FK uuid categoryId FK int price int stock ProductStatus status jsonb attributes }
  PRODUCT_IMAGES { uuid productId PK,FK int position PK text key }
  ORDERS { uuid id PK text orderNumber UK uuid customerId FK int grandTotal OrderStatus status PaymentStatus paymentStatus jsonb shippingAddress }
  SUB_ORDERS { uuid id PK uuid orderId FK uuid vendorId FK int payable int commission int vendorNet SubOrderStatus status PayoutStatus payoutStatus }
  ORDER_LINES { uuid id PK uuid orderId FK uuid subOrderId FK uuid productId int price int qty int commissionRateBp }
  SUB_ORDER_EVENTS { uuid id PK uuid subOrderId FK SubOrderStatus status timestamptz at ActorRole byRole }
  INVOICES { uuid id PK uuid subOrderId FK,UK text invoiceNumber UK text s3Key }
  REVIEWS { uuid id PK uuid productId FK uuid userId FK int rating ReviewStatus status }
  COUPONS { uuid id PK text code UK CouponScope scope CouponType type int value int usedCount }
  COUPON_REDEMPTIONS { uuid id PK uuid couponId FK uuid userId uuid orderId }
  LEDGER_ENTRIES { uuid id PK text key UK LedgerType type uuid orderId uuid subOrderId int amount }
