  USERS ||--o| VENDORS : "owns store"
  USERS ||--o{ ORDERS : places
  USERS ||--o{ REVIEWS : writes
  VENDORS ||--o{ PRODUCTS : lists
  VENDORS ||--o{ SUB_ORDERS : fulfils
  VENDORS ||--o{ COUPONS : "store coupons"
  CATEGORIES ||--o{ PRODUCTS : groups
  CATEGORIES ||--o{ CATEGORIES : "parent of"
  PRODUCTS ||--o{ PRODUCT_IMAGES : "photos (max 6)"
  PRODUCTS ||--o{ REVIEWS : receives
  ORDERS ||--|{ SUB_ORDERS : "split per store"
  ORDERS ||--|{ ORDER_LINES : contains
  SUB_ORDERS ||--|{ ORDER_LINES : ships
  SUB_ORDERS ||--|{ SUB_ORDER_EVENTS : "status history"
