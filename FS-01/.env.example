# Copy to .env (Windows: copy .env.example .env). Docker Compose reads it; every value has a safe local default.

# Port for the web app on this PC (http://localhost:3000)
FRONTEND_PORT=3000
LOG_LEVEL=info

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Elasticsearch memory; 512 MB is enough locally
ES_JAVA_OPTS=-Xms512m -Xmx512m

# File storage bucket (local S3 mock in Docker; real AWS S3 on the live site)
S3_REGION=ap-south-1
S3_BUCKET=shopsphere-local

# Payments: "mock" works offline with no account; "razorpay" needs test keys (added on Day 6)
PAYMENT_PROVIDER=mock

# Sign-in. The secret signs access tokens: this value is for your PC only; the live site gets its own random one
# (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
JWT_ACCESS_SECRET=local-dev-only-jwt-secret-never-use-on-the-live-site-0001
# Cookies: plain http on localhost. The live site (app and API on different domains) needs true + none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Password for the demo accounts created by: docker compose exec api node dist/scripts/seed-users.js
DEMO_PASSWORD=ShopSphere-demo-2026
